# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.js text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.ejs text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Environment files
.env.example text eol=lf

# Handle Windows line endings for specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary